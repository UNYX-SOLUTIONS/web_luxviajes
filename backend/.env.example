# ============================================================
#  LUX VIAJES - BACKEND (.env ÚNICO - Plantilla)
# ============================================================
#  Copiar a .env y llenar. Ver comentarios del archivo real.
# ============================================================

# ---------- 1. SERVIDOR ----------
NODE_ENV=development
PORT=3001

# ---------- 2. BASE DE DATOS ----------
# LOCAL (tu PC)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/luxdb?schema=public"
# VPS (contenedor postgres)
DB_USER=luxviajes
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_NAME=luxviajes_db

# ---------- 3. MIGRACIONES ----------
RUN_MIGRATIONS=true

# ---------- 4. DATAFAST ----------
DATAFAST_ENV=test

# TEST (Fase 2)
DATAFAST_TEST_ENTITY_ID=TU_ENTITY_ID_TEST
DATAFAST_TEST_BEARER_TOKEN=TU_TOKEN_TEST
DATAFAST_TEST_MERCHANT_ID=1000000505
DATAFAST_TEST_TERMINAL_ID=PD100406
DATAFAST_TEST_BASE_URL=https://eu-test.oppwa.com
DATAFAST_TEST_SHOPPER_RESULT_URL=http://localhost:3000/pago/resultado

# PRODUCCIÓN
DATAFAST_PROD_ENTITY_ID=TU_ENTITY_ID_PROD
DATAFAST_PROD_BEARER_TOKEN=TU_TOKEN_PROD
DATAFAST_PROD_MERCHANT_ID=4100010042
DATAFAST_PROD_TERMINAL_ID=BP467901
DATAFAST_PROD_BASE_URL=https://eu-prod.oppwa.com
DATAFAST_PROD_SHOPPER_RESULT_URL=https://agencialuxviajes.com/pago/resultado

# ---------- 5. CORS ----------
ALLOWED_ORIGINS_PROD=https://agencialuxviajes.com,https://www.agencialuxviajes.com

# ---------- 6. TIMEOUTS Y LOGS ----------
DATAFAST_TIMEOUT=30000
DATAFAST_RETRY_ATTEMPTS=3
LOG_LEVEL=info
