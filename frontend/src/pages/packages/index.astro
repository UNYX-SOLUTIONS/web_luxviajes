---
import MainLayout from '../../layouts/MainLayout.astro';
import { packages, whatsappUrl } from '../../data/site';
---

<MainLayout
  title="Packages | Luxviajes"
  description="Paquetes turisticos nacionales e internacionales con asesoria personalizada desde Ecuador."
  currentPath={Astro.url.pathname}
>
  <section class="page-shell">
    <div class="mb-10">
      <p class="section-kicker">Packages</p>
      <h1 class="font-display text-5xl text-slate-950">Paquetes Turisticos Internacionales</h1>
      <p class="mt-4 max-w-3xl text-slate-700">
        Ofertas curadas por temporada con configuracion de vuelos, hospedaje y experiencias premium.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {packages.map((item, index) => (
        <article class={`reveal delay-${(index % 3) + 1} card p-7`}>
          <div class="flex items-center justify-between gap-3">
            <p class="text-xs uppercase tracking-[0.2em] text-purple-700">{item.highlight}</p>
            <p class="text-sm font-semibold text-slate-600">{item.duration}</p>
          </div>
          <h2 class="mt-3 font-display text-3xl text-purple-900">{item.name}</h2>
          <p class="mt-3 text-slate-700">{item.summary}</p>
          <a href={whatsappUrl} target="_blank" rel="noreferrer" class="mt-5 inline-block text-sm font-semibold text-purple-700 hover:text-purple-900">
            Solicitar cotizacion
          </a>
        </article>
      ))}
    </div>
  </section>
</MainLayout>
