# ============================================
# NODE - Configuración del servidor
# ============================================
NODE_ENV=development
PORT=3001
HOST=localhost

# ============================================
# BASE DE DATOS - PostgreSQL
# ============================================
DATABASE_URL=postgresql://usuario:password@localhost:5432/tu_db?schema=public

# ============================================
# REDIS - Cache y colas (opcional)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# DATAFAST - Configuración
# ============================================

# >>> INTERRUPTOR DE AMBIENTE: test | production <<<
DATAFAST_ENV=test

# ---------- TEST (Fase 2) ----------
DATAFAST_TEST_ENTITY_ID=tu_entity_id_test
DATAFAST_TEST_BEARER_TOKEN=tu_bearer_token_test
DATAFAST_TEST_MERCHANT_ID=1000000505
DATAFAST_TEST_TERMINAL_ID=PD100406
DATAFAST_TEST_BASE_URL=https://eu-test.oppwa.com
DATAFAST_TEST_SHOPPER_RESULT_URL=http://localhost:3000/pago/resultado

# ---------- PRODUCCIÓN ----------
# Para pasar a producción: DATAFAST_ENV=production y llenar estos valores
DATAFAST_PROD_ENTITY_ID=tu_entity_id_produccion
DATAFAST_PROD_BEARER_TOKEN=tu_bearer_token_produccion
DATAFAST_PROD_MERCHANT_ID=4100010042
DATAFAST_PROD_TERMINAL_ID=BP467901
DATAFAST_PROD_BASE_URL=https://eu-prod.oppwa.com
DATAFAST_PROD_SHOPPER_RESULT_URL=https://tudominio.com/pago/resultado

# testMode se envía automáticamente solo en test.
# Opcional: DATAFAST_TEST_MODE=false para desactivarlo en pruebas.

DATAFAST_TIMEOUT=30000
DATAFAST_RETRY_ATTEMPTS=3

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# JWT
# ============================================
JWT_SECRET=tu_secret_aqui
JWT_EXPIRES_IN=7d

# ============================================
# LOGS
# ============================================
LOG_LEVEL=info

# ============================================
# FEATURES
# ============================================
FEATURE_RECURRING_PAYMENTS=true
FEATURE_ONE_CLICK_CHECKOUT=true
FEATURE_REFUNDS=true
FEATURE_CREDIT_TYPES=true