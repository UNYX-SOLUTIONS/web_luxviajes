---
import MainLayout from '../../layouts/MainLayout.astro';
import { contactEmail, whatsappUrl } from '../../data/site';

const premiumServices = [
  {
    title: 'Boleteria Aerea',
    description: 'Vuelos a cualquier destino con las mejores tarifas y gestion integral de cambios.',
    icon: '✈'
  },
  {
    title: 'Paquetes Internacionales',
    description: 'Experiencias en 5 continentes, desde resorts de ultra lujo hasta tours de expedicion privada.',
    icon: '◌'
  },
  {
    title: 'Visas y Tramites',
    description: 'Asesoria experta para documentos de viaje, garantizando un proceso sin complicaciones.',
    icon: '🛡'
  },
  {
    title: 'Concierge de Lujo',
    description: 'Traslados privados, reservas premium y acceso a eventos exclusivos.',
    icon: '☖'
  }
];

const workflow = [
  {
    number: '1',
    title: 'Consulta',
    text: 'Entendemos sus deseos, preferencias y el proposito unico de su viaje.'
  },
  {
    number: '2',
    title: 'Personalizacion',
    text: 'Disenamos un itinerario a medida con acceso a beneficios y tarifas exclusivas.'
  },
  {
    number: '3',
    title: 'Viaje sin preocupaciones',
    text: 'Soporte 24/7 mientras usted se dedica a disfrutar de la experiencia.'
  }
];

const faqs = [
  {
    question: '¿Cuentan con seguros de viaje internacionales?',
    answer:
      'Si, ofrecemos coberturas integrales que incluyen asistencia medica, proteccion de equipaje y cancelacion de viaje.'
  },
  {
    question: '¿Que metodos de pago aceptan?',
    answer:
      'Aceptamos transferencia bancaria, tarjetas de credito principales y pagos programados para paquetes seleccionados.'
  },
  {
    question: '¿Cual es su politica de cancelaciones?',
    answer:
      'Cada producto tiene condiciones especificas. Nuestro equipo le explica politicas y penalidades antes de confirmar.'
  }
];
---

<MainLayout
  title="Services | Luxviajes"
  description="Servicios de agencia de viajes en Ecuador: boletos, paquetes, visas, cruceros y seguros."
  currentPath={Astro.url.pathname}
>
  <section class="mx-auto w-full max-w-7xl px-5 pt-10 md:px-8">
    <div class="overflow-hidden rounded-3xl border border-purple-200 bg-white">
      <div class="relative px-6 py-16 text-center md:px-10">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(107,33,168,0.12),transparent_50%),radial-gradient(circle_at_85%_25%,rgba(107,33,168,0.08),transparent_40%)]"></div>
        <div class="relative">
          <p class="section-kicker">Elite Concierge</p>
          <h1 class="font-display text-5xl leading-tight text-slate-950 md:text-7xl">
            Nuestros Servicios
            <span class="text-purple-700">Exclusivos</span>
          </h1>
          <p class="mx-auto mt-5 max-w-3xl text-lg text-slate-700">
            Elevamos cada trayecto a una obra maestra. Disfrute de un acompanamiento personalizado diseniado para los viajeros mas exigentes del mundo.
          </p>
        </div>
      </div>

      <div class="bg-[#efe7f3] px-6 py-12 md:px-10">
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {premiumServices.map((item, index) => (
            <article class={`reveal delay-${(index % 3) + 1} card p-6`}>
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-purple-100 text-lg text-purple-700">
                {item.icon}
              </span>
              <h2 class="mt-5 font-display text-2xl text-slate-950">{item.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-slate-700">{item.description}</p>
              <a href={whatsappUrl} target="_blank" rel="noreferrer" class="mt-5 inline-block text-sm font-semibold text-purple-700 hover:text-purple-900">
                Explorar →
              </a>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-7xl px-5 py-16 md:px-8">
    <div class="card p-8 md:p-12">
      <h2 class="text-center font-display text-5xl text-slate-950">Como Trabajamos</h2>
      <p class="mt-3 text-center text-slate-600">Un proceso refinado para garantizar la perfeccion en cada kilometro.</p>

      <div class="relative mt-10 grid gap-8 md:grid-cols-3">
        <div class="absolute left-[16%] right-[16%] top-5 hidden h-px bg-purple-200 md:block"></div>
        {workflow.map((step, index) => (
          <article class={`reveal delay-${(index % 3) + 1} text-center`}>
            <span class="relative z-10 inline-flex h-11 w-11 items-center justify-center rounded-full bg-purple-700 font-bold text-white">
              {step.number}
            </span>
            <h3 class="mt-5 font-display text-2xl text-slate-950">{step.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-7xl px-5 pb-16 md:px-8">
    <div class="card bg-[#eee6f2] p-8 md:p-12">
      <h2 class="text-center font-display text-5xl text-slate-950">Preguntas Frecuentes</h2>
      <div class="mx-auto mt-8 max-w-4xl space-y-3">
        {faqs.map((faq, index) => (
          <details class={`reveal delay-${(index % 3) + 1} rounded-2xl border border-purple-200 bg-white p-5`} open={index === 0}>
            <summary class="cursor-pointer list-none text-base font-semibold text-slate-900">
              <div class="flex items-center justify-between gap-3">
                <span>{faq.question}</span>
                <span class="text-purple-700">⌄</span>
              </div>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-7xl px-5 pb-20 md:px-8">
    <div class="rounded-[2rem] bg-gradient-to-b from-purple-700 to-purple-800 px-6 py-14 text-center text-white shadow-[0_16px_40px_rgba(76,29,149,0.28)] md:px-10">
      <h2 class="font-display text-5xl leading-tight">¿Listo para tu proxima aventura?</h2>
      <p class="mx-auto mt-4 max-w-2xl text-purple-100">
        Permitanos convertir sus suenios en itinerarios memorables. Su conserje personal esta a un clic de distancia.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={`mailto:${contactEmail}`} class="inline-flex items-center justify-center rounded-full bg-amber-500 px-7 py-3 font-semibold text-white transition hover:bg-amber-400">
          Contactanos hoy
        </a>
        <a href={whatsappUrl} target="_blank" rel="noreferrer" class="inline-flex items-center justify-center rounded-full border border-purple-300 bg-white/10 px-7 py-3 font-semibold text-white transition hover:bg-white/20">
          Hablar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</MainLayout>
