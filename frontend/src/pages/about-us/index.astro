---
import MainLayout from '../../layouts/MainLayout.astro';
import { offices, contactEmail, whatsappUrl } from '../../data/site';
---

<MainLayout
  title="About Us | Luxviajes"
  description="Conoce Luxviajes, nuestro enfoque y oficinas en Guayaquil, Quito y Cuenca."
  currentPath={Astro.url.pathname}
>
  <section class="page-shell">
    <div class="mb-10">
      <p class="section-kicker">About Us</p>
      <h1 class="font-display text-5xl text-slate-950">Equipo, metodo y cobertura nacional</h1>
      <p class="mt-4 max-w-3xl text-slate-700">
        Luxviajes opera como concierge de viajes con enfoque consultivo. Disenamos experiencias con estandares altos y soporte continuo para clientes exigentes.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      <article class="card p-6">
        <h2 class="font-display text-2xl text-purple-900">Vision</h2>
        <p class="mt-3 text-slate-700">Convertir cada viaje en una experiencia bien planificada, segura y memorable.</p>
      </article>
      <article class="card p-6">
        <h2 class="font-display text-2xl text-purple-900">Metodo</h2>
        <p class="mt-3 text-slate-700">Diagnostico, propuesta, ejecucion y soporte 24/7 en cada etapa del recorrido.</p>
      </article>
      <article class="card p-6">
        <h2 class="font-display text-2xl text-purple-900">Compromiso</h2>
        <p class="mt-3 text-slate-700">Atencion humana por WhatsApp y seguimiento activo hasta tu regreso.</p>
      </article>
    </div>

    <div class="mt-12">
      <h2 class="font-display text-4xl text-slate-950">Oficinas</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {offices.map((office, index) => (
          <article class={`reveal delay-${(index % 3) + 1} card p-6`}>
            <h3 class="font-display text-2xl text-purple-900">{office.city}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{office.address}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="mt-12 card bg-purple-700 p-7 text-white">
      <h3 class="font-display text-3xl">Contacto Directo</h3>
      <p class="mt-3 text-purple-100">Escribenos para planificar tu proxima ruta o resolver tramites de viaje.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={whatsappUrl} target="_blank" rel="noreferrer" class="btn-light">WhatsApp</a>
        <a href={`mailto:${contactEmail}`} class="btn-secondary border-white/40 text-white hover:bg-white/20">Email</a>
      </div>
    </div>
  </section>
</MainLayout>
