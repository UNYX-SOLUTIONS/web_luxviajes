# ============================================
# NODE - Configuración del servidor
# ============================================
NODE_ENV=development
PORT=3001
HOST=localhost

# ============================================
# BASE DE DATOS - PostgreSQL
# ============================================
DATABASE_URL=postgresql://usuario:password@localhost:5432/tu_db?schema=public

# ============================================
# REDIS - Cache y colas (opcional)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# DATAFAST - Configuración
# ============================================
# PRODUCCIÓN (credenciales entregadas por Datafast):
# NODE_ENV=production
# DATAFAST_ENTITY_ID=<entity id de producción>
# DATAFAST_BEARER_TOKEN=<access token de producción>
# DATAFAST_MERCHANT_ID=4100010042
# DATAFAST_TERMINAL_ID=BP467901
# DATAFAST_BASE_URL=<url de producción indicada por Datafast>
# DATAFAST_SHOPPER_RESULT_URL=https://tudominio.com/pago/resultado
# (NO definir DATAFAST_TEST_MODE — el testMode se envía solo si es true)
#
# PRUEBAS (Fase 2):
DATAFAST_ENTITY_ID=tu_entity_id
DATAFAST_BEARER_TOKEN=tu_bearer_token
DATAFAST_MERCHANT_ID=tu_merchant_id
DATAFAST_TERMINAL_ID=tu_terminal_id
DATAFAST_BASE_URL=https://eu-test.oppwa.com
DATAFAST_SHOPPER_RESULT_URL=http://localhost:3000/pago/resultado
# Solo para pruebas: envía testMode=EXTERNAL. Eliminar en producción.
DATAFAST_TEST_MODE=true
DATAFAST_TIMEOUT=30000
DATAFAST_RETRY_ATTEMPTS=3
DATAFAST_ECI=0103910
DATAFAST_PSERV=17913101
DATAFAST_VERSION=2
DATAFAST_CURRENCY=USD
DATAFAST_PAYMENT_TYPE=DB

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# JWT
# ============================================
JWT_SECRET=tu_secret_aqui
JWT_EXPIRES_IN=7d

# ============================================
# LOGS
# ============================================
LOG_LEVEL=info

# ============================================
# FEATURES
# ============================================
FEATURE_RECURRING_PAYMENTS=true
FEATURE_ONE_CLICK_CHECKOUT=true
FEATURE_REFUNDS=true
FEATURE_CREDIT_TYPES=true