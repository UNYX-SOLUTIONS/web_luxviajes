// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                   String           @id @default(uuid())
  merchantCustomerId   String           @unique
  givenName            String
  middleName           String?
  surname              String
  email                String           @unique
  phone                String
  identificationDocType String          @default("IDCARD")
  identificationDocId  String           @unique
  address              String
  country              String           @default("EC")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  
  transactions         Transaction[]
  tokens               Token[]
  recurringPayments    RecurringPayment[]
}

model Transaction {
  id                   String           @id @default(uuid())
  merchantTransactionId String          @unique
  checkoutId           String?
  paymentId            String?          @unique
  amount               Decimal          @db.Decimal(10,2)
  currency             String           @default("USD")
  paymentType          String           @default("DB")
  
  // Datos de la transacción
  status               PaymentStatus    @default(PENDING)
  resultCode           String?
  resultDescription    String?
  responseCode         String?
  authCode             String?
  acquirerCode         String?
  acquirerName         String?
  
  // Impuestos
  base0                Decimal          @db.Decimal(10,2)
  baseImp              Decimal          @db.Decimal(10,2)
  iva                  Decimal          @db.Decimal(10,2)
  
  // Datos del cliente
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  
  // Datos de productos
  items                Json?
  
  // Metadatos
  metadata             Json?
  errorDetails         Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  
  refunds              Refund[]
  recurringPayments    RecurringPayment?
  reservation          Reservation?

  @@index([checkoutId])
}

model Token {
  id                   String           @id @default(uuid())
  registrationId       String           @unique  // Token de Datafast
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  
  // Últimos 4 dígitos para identificación
  lastFourDigits       String
  cardType             String?           // DC, PM, MI, PV, VI, etc.
  expiryDate           String?
  
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  
  recurringPayments    RecurringPayment[]
}

model RecurringPayment {
  id                   String           @id @default(uuid())
  transactionId        String           @unique
  transaction          Transaction      @relation(fields: [transactionId], references: [id])
  tokenId              String
  token                Token            @relation(fields: [tokenId], references: [id])
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  
  frequency            RecurringFrequency @default(MONTHLY)
  nextChargeDate       DateTime
  endDate              DateTime?
  amount               Decimal          @db.Decimal(10,2)
  status               RecurringStatus  @default(ACTIVE)
  
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Refund {
  id                   String           @id @default(uuid())
  transactionId        String
  transaction          Transaction      @relation(fields: [transactionId], references: [id])
  amount               Decimal          @db.Decimal(10,2)
  refundId             String?          // ID de Datafast
  status               RefundStatus     @default(PENDING)
  reason               String?
  metadata             Json?
  
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model AuditLog {
  id                   String           @id @default(uuid())
  userId               String?
  action               String
  entity               String
  entityId             String?
  details              Json
  ipAddress            String?
  userAgent            String?
  
  createdAt            DateTime         @default(now())
}

model User {
  id                    String    @id @default(cuid())
  primerNombre          String?
  segundoNombre         String?
  apellido              String?
  email                 String    @unique
  password              String
  telefono              String?
  cedula                String?
  direccion             String?
  pais                  String    @default("EC")
  fotoPerfil            String?
  rol                   String    @default("USER")
  emailVerificado       Boolean   @default(false)
  emailVerificationToken String?
  emailVerifiedAt       DateTime?
  loginAttempts         Int       @default(0)
  lockedUntil           DateTime?
  tokenVersion          Int       @default(0)
  lastLogin             DateTime?
  securityLogs          SecurityLog[]
  reservations          Reservation[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  event     String
  details   Json
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model PendingRegistration {
  id                   String    @id @default(cuid())
  primerNombre         String?
  segundoNombre        String?
  apellido             String?
  email                String    @unique
  password             String
  telefono             String?
  cedula               String?
  direccion            String?
  pais                 String    @default("EC")
  verificationCode     String
  codeExpiresAt        DateTime
  verificationAttempts Int       @default(0)
  maxAttempts          Int       @default(5)
  webhookSent          Boolean   @default(false)
  webhookSentAt        DateTime?
  verifiedAt           DateTime?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
  REVERSED
}

enum RecurringFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReservationLocation {
  MATRIZ
  GUAYAQUIL
  QUITO
  CUENCA
  SIN_PREFERENCIA
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Reservation {
  id               String              @id @default(uuid())
  userId           String?
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactionId    String?             @unique
  transaction      Transaction?        @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  name             String
  lastName         String
  email            String
  phone            String
  appointmentDate  DateTime
  location         ReservationLocation @default(SIN_PREFERENCIA)
  source           String              @default("calendar")
  receivePromotion Boolean             @default(false)
  status           ReservationStatus   @default(CONFIRMED)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([userId])
  @@index([email])
  @@index([appointmentDate])
}
