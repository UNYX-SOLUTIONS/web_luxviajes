---
import MainLayout from '../layouts/MainLayout.astro';
import { services, packages, whatsappUrl } from '../data/site';

const featuredServices = services.slice(0, 3);
const featuredPackages = packages.slice(0, 3);
---

<MainLayout
  title="Luxviajes | Premium Travel Concierge"
  description="Agencia de viajes y visas en Ecuador con servicios premium y atencion personalizada."
  currentPath={Astro.url.pathname}
>
  <section class="relative min-h-[72vh] overflow-hidden">
    <img
      src="https://images.unsplash.com/photo-1573843981267-be1999ff37cd?auto=format&fit=crop&w=1900&q=80"
      alt="Resort tropical de lujo"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/30 to-black/20"></div>

    <div class="relative mx-auto flex h-full w-full max-w-7xl flex-col items-center justify-center px-5 py-20 text-center md:px-8">
      <p class="reveal rounded-full border border-white/40 bg-white/20 px-5 py-2 text-xs font-semibold uppercase tracking-[0.22em] text-white">
        Premium Travel Concierge
      </p>
      <h1 class="reveal delay-1 mt-6 font-display text-4xl leading-tight text-white md:text-7xl">
        Tu Viaje Sonado de
        <span class="block italic font-medium text-amber-200">Principio a Fin</span>
      </h1>
      <p class="reveal delay-2 mt-6 max-w-2xl text-balance text-slate-100">
        Plataforma modular para gestionar viajes, paquetes y asesorias de visa con enfoque profesional.
      </p>
      <div class="reveal delay-2 mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/services/" class="btn-primary">Ver Services</a>
        <a href="/packages/" class="btn-secondary">Explorar Packages</a>
      </div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-7xl px-5 py-16 md:px-8">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="section-kicker">Services</p>
        <h2 class="font-display text-4xl text-slate-950">Capacidades Principales</h2>
      </div>
      <a href="/services/" class="text-sm font-semibold text-purple-700 hover:text-purple-900">Ver todos</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {featuredServices.map((item, index) => (
        <article class={`reveal delay-${index + 1} card p-6`}>
          <h3 class="font-display text-2xl text-purple-900">{item.title}</h3>
          <p class="mt-3 text-slate-700">{item.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto w-full max-w-7xl px-5 pb-16 md:px-8">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <p class="section-kicker">Packages</p>
        <h2 class="font-display text-4xl text-slate-950">Destinos Destacados</h2>
      </div>
      <a href="/packages/" class="text-sm font-semibold text-purple-700 hover:text-purple-900">Ir a Packages</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {featuredPackages.map((item, index) => (
        <article class={`reveal delay-${index + 1} card p-6`}>
          <p class="text-xs uppercase tracking-[0.18em] text-purple-700">{item.highlight}</p>
          <h3 class="mt-2 font-display text-2xl text-purple-900">{item.name}</h3>
          <p class="mt-1 text-sm font-semibold text-slate-600">{item.duration}</p>
          <p class="mt-3 text-slate-700">{item.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto w-full max-w-7xl px-5 pb-20 md:px-8">
    <div class="card bg-purple-700 px-6 py-12 text-center md:px-10">
      <h2 class="font-display text-4xl text-white">Arquitectura Lista Para Escalar</h2>
      <p class="mx-auto mt-4 max-w-2xl text-purple-100">
        Estructura separada por rutas, layout reutilizable y fuente unica de datos para mantenimiento profesional.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/about-us/" class="btn-light">Conocer About Us</a>
        <a href={whatsappUrl} target="_blank" rel="noreferrer" class="btn-secondary border-white/40 text-white hover:bg-white/20">
          Contactar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</MainLayout>
