# ============================================
# Backend Lux Viajes - Variables de Docker
# ============================================
# Copiar a .env (en la carpeta backend/) y llenar los valores reales.
# NUNCA subir el archivo .env al repositorio.
# Este archivo solo cubre docker-compose; la app en local usa .env propio.

# ---------- PostgreSQL ----------
DB_USER=luxviajes
DB_PASSWORD=cambiar_por_password_seguro
DB_NAME=luxviajes_db

# ---------- Migraciones ----------
# true: aplica `prisma migrate deploy` al iniciar el contenedor
RUN_MIGRATIONS=true

# ---------- CORS ----------
# Orígenes permitidos separados por coma (el app usa ALLOWED_ORIGINS)
ALLOWED_ORIGINS=https://luxviajes.com,https://www.luxviajes.com

# ---------- Datafast PRODUCCIÓN ----------
DATAFAST_ENTITY_ID=<entity_id_produccion>
DATAFAST_BEARER_TOKEN=<access_token_produccion>
DATAFAST_MERCHANT_ID=4100010042
DATAFAST_TERMINAL_ID=BP467901
DATAFAST_BASE_URL=<url_produccion_datafast>
DATAFAST_SHOPPER_RESULT_URL=https://luxviajes.com/pago/resultado
DATAFAST_TIMEOUT=30000
DATAFAST_RETRY_ATTEMPTS=3
# IMPORTANTE: NO definir DATAFAST_TEST_MODE en producción

# ---------- Logs ----------
LOG_LEVEL=info
